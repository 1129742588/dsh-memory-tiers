{
  "name": "dsh-memory-tiers",
  "version": "1.3.0",
  "description": "dsh 的六层本地记忆：每轮收进 L1，满了分流成摘要与原文档，长期层注入上下文，并用记忆替代对话历史；按会话工作模式、人格槽位、记忆星图与热改配置。",
  "type": "module",
  "main": "index.mjs",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "context"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1129742588/dsh-memory-tiers.git"
  },
  "homepage": "https://github.com/1129742588/dsh-memory-tiers#readme",
  "bugs": {
    "url": "https://github.com/1129742588/dsh-memory-tiers/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.mjs",
    "./memory": "./memory.mjs",
    "./llm": "./llm.mjs",
    "./settings": "./settings.mjs",
    "./star": "./star.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "memory.mjs",
    "llm.mjs",
    "settings.mjs",
    "client.mjs",
    "star.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test ../test/memory.test.mjs ../test/config.test.mjs ../test/flow.test.mjs"
  }
}
