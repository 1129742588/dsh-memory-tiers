{
  "name": "dsh-memory-tiers",
  "version": "0.5.1",
  "description": "六层记忆插件：L1/L2/L3 活跃层 + DL1/DL2/DL3 深层，自动捕获写入、摘要沉淀、按需召回，并接管历史压缩（零 LLM）。",
  "type": "module",
  "main": "index.mjs",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "compaction",
    "context"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1129742588/dsh-memory-tiers.git"
  },
  "homepage": "https://github.com/1129742588/dsh-memory-tiers#readme",
  "bugs": {
    "url": "https://github.com/1129742588/dsh-memory-tiers/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.mjs",
    "./compaction.mjs": "./compaction.mjs",
    "./memory5.mjs": "./memory5.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.mjs",
    "settings.mjs",
    "compaction.mjs",
    "memory5.mjs",
    "silicon.mjs",
    "cordis.patch.yml",
    "README.md",
    "ARCHITECTURE.md",
    "reindex.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "reindex": "node reindex.mjs"
  }
}
