{
  "name": "dsh-memory-tiers",
  "version": "0.8.1",
  "description": "给 dsh 加长期记忆，并把每轮 token 压住不涨：自动记住对话、按需检索、接管历史压缩（零 LLM）。",
  "type": "module",
  "main": "index.mjs",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "compaction",
    "context"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1129742588/dsh-memory-tiers.git"
  },
  "homepage": "https://github.com/1129742588/dsh-memory-tiers#readme",
  "bugs": {
    "url": "https://github.com/1129742588/dsh-memory-tiers/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.mjs",
    "./compaction.mjs": "./compaction.mjs",
    "./memory5.mjs": "./memory5.mjs",
    "./memory6.mjs": "./memory6.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./dshllm.mjs": "./dshllm.mjs"
  },
  "files": [
    "index.mjs",
    "client.mjs",
    "settings.mjs",
    "compaction.mjs",
    "memory5.mjs",
    "memory6.mjs",
    "silicon.mjs",
    "cordis.patch.yml",
    "README.md",
    "ARCHITECTURE.md",
    "reindex.mjs",
    "dshllm.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "reindex": "node reindex.mjs",
    "test:m6": "node test-memory6.mjs"
  }
}
